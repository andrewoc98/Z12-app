# Copy to android/keystore.properties and fill in. That file is gitignored — the keystore
# and these passwords must never be committed.
#
# This must be the SAME upload key the live Play listing was signed with. A new key will be
# rejected. If it's lost, Play Console -> Setup -> App signing -> Request upload key reset
# (only possible if the app is enrolled in Play App Signing).
storeFile=/absolute/path/to/upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
